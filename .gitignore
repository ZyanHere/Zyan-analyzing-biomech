# Python environment - rebuilt from requirements.txt
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Pose models - 44 MB, downloaded from Google. See README for the command.
biomech/models/*.task

# Recorded media contains video and stills OF THE SUBJECT.
# This repository is PUBLIC. Committing these publishes them.
# Landmark data (*.jsonl) is kept: it is what replay needs, and it holds
# coordinates rather than images.
biomech/research/fixtures/**/*.mp4
biomech/research/fixtures/**/*.png
biomech/research/fixtures/**/*.jpg

# Keep the printed reference sheet
!biomech/research/fixtures/reference/protractor_A4.png
